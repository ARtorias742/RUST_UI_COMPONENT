{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nextjs": {
      "root": "web/nextjs",
      "framework": "nextjs"
    },
    "rust-frontend": {
      "root": "web/rust-frontend",
      "buildCommand": "true",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/rust/(.*)", "destination": { "service": "rust-frontend" } },
    { "source": "/(.*)", "destination": { "service": "nextjs" } }
  ]
}